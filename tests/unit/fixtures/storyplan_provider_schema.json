{
  "properties": {
    "title": {
      "description": "In the story language",
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "logline": {
      "description": "In the story language. One sentence",
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
    },
    "story": {
      "description": "In the story language",
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "characters": {
      "items": {
        "properties": {
          "name": {
            "description": "In the story language; prompts refer to the entity by exactly this name",
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "entity_type": {
            "enum": [
              "character",
              "creature",
              "visual_asset",
              "generic_troop",
              "faction"
            ],
            "type": "string"
          },
          "description": {
            "description": "ENGLISH. Visual appearance only",
            "maxLength": 600,
            "minLength": 1,
            "type": "string"
          },
          "voice_description": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ENGLISH. Optional, for characters and creatures: voice tone and pace, at most ~30 words"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "type": "array"
    },
    "locations": {
      "items": {
        "properties": {
          "name": {
            "description": "In the story language; prompts refer to the entity by exactly this name",
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "description": "ENGLISH. Visual appearance only",
            "maxLength": 600,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "type": "array"
    },
    "scenes": {
      "items": {
        "properties": {
          "summary": {
            "description": "In the story language",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "image_prompt": {
            "description": "ENGLISH. Still frame: action, composition, setting; entity names exactly as declared",
            "maxLength": 1500,
            "minLength": 1,
            "type": "string"
          },
          "video_prompt": {
            "description": "ENGLISH. ~8 seconds of motion as prose or timed beats ('0-4s: ... 4-8s: ...'), then Audio:, SFX: and Negative: lines",
            "maxLength": 1500,
            "minLength": 1,
            "type": "string"
          },
          "narration": {
            "anyOf": [
              {
                "maxLength": 600,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "In the story language. Voice-over, about 8 seconds"
          },
          "character_names": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "continues_previous": {
            "type": "boolean"
          }
        },
        "required": [
          "summary",
          "image_prompt",
          "video_prompt"
        ],
        "type": "object"
      },
      "maxItems": 30,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "title",
    "logline",
    "story",
    "scenes"
  ],
  "type": "object"
}
