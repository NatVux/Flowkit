# Flow Kit runtime configuration
# Keep the Python agent and Chrome/Flow bridge on the same host by default.
FLOW_AGENT_DIR=./agent
API_HOST=127.0.0.1
API_PORT=8100
WS_HOST=127.0.0.1
WS_PORT=9222

# Required for batchexecute generation
FLOW_PROJECT_ID=
FLOW_ALLOW_DEGRADED=0
DEFAULT_PAYGATE_TIER=PAYGATE_TIER_TWO

# Worker
POLL_INTERVAL=5
VIDEO_POLL_INTERVAL=10
MAX_RETRIES=5
VIDEO_POLL_TIMEOUT=420
API_COOLDOWN=10
MAX_CONCURRENT_REQUESTS=5
STALE_PROCESSING_TIMEOUT=600
WORKER_OPERATION_TIMEOUT=900
RETRY_JITTER_SECONDS=3

# Optional scheduled backups; 0 disables the in-process scheduler
BACKUP_INTERVAL_SECONDS=0
LOG_LEVEL=INFO

# Media/TTS/review settings
TTS_MODEL=k2-fsa/OmniVoice
TTS_DEVICE=cpu
TTS_SAMPLE_RATE=24000
REVIEW_MODEL=claude-haiku-4-5-20251001
REVIEW_FPS_LIGHT=4
REVIEW_FPS_DEEP=8
REVIEW_MAX_FRAMES=64
REVIEW_CLI_TIMEOUT_S=120

# Secrets are intentionally omitted. Provide them through the process environment
# or an OS secret manager, never by committing a .env file.
# ANTHROPIC_API_KEY=
# SUNO_API_KEY=
# TTS_PYTHON_BIN=python3.10

# Optional AI content planning (stories, scenes, prompts, narration, YouTube metadata).
# Leave GEMINI_API_KEY empty to disable; Flow still generates all media.
# AI_PROVIDER: empty = auto (gemini if a key is set), gemini, mock, or none
AI_PROVIDER=
# GEMINI_API_KEY=            (secret: set in the environment, never commit)
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=2
